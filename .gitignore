# dbt generated files
# ------------------------------
/target/
/dbt_packages/

# dbt logs
/logs/
*.log

# dbt profiles / env vars (adjust if you use a different mechanism)
.env
.env.*

# ------------------------------
# Python (virtual environments & caches)
# ------------------------------
*.pyc
__pycache__/
.venv/
venv/
env/
ENV/

# ------------------------------
# IDE / Editors
# ------------------------------
.idea/
.vscode/

# ------------------------------
# OS files
# ------------------------------
.DS_Store

# ------------------------------
